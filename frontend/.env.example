# ==============================================================================
# TEAM PRODUCTIVITY HUB - FRONTEND CONFIGURATION TEMPLATE
# ==============================================================================

# Backend API Base URLs (configured via environments/environment.ts & environment.prod.ts)
API_BASE_URL=http://127.0.0.1:8000/api
AUTH_BASE_URL=http://127.0.0.1:8000/api/auth

# Optional Third-Party Service Integrations
ANALYTICS_SERVICE_URL=
NOTIFICATION_SERVICE_URL=
SQL_SERVER_GATEWAY_URL=

# Note: In Angular applications, client-side code loads environment constants from
# src/environments/environment.ts during local development, and environment.prod.ts during production build.

